<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Upstream grants this friend assembly internal engine access. -->
    <AssemblyName>OfflineSearchHarness</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(ValidationOracle)' == 'true'">$(DefineConstants);DESKTOP_ORACLE</DefineConstants>
    <WorkDir>$(MSBuildProjectDirectory)/../../ios-export/.work/solver-inputs</WorkDir>
    <UpstreamHarness>$(WorkDir)/source/CombatSolver/tools/search/OfflineSearchHarness</UpstreamHarness>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;AssemblyBootstrap.cs;AccessChecks.cs" />
    <Compile Include="$(UpstreamHarness)/GameBootstrap.cs;$(UpstreamHarness)/OfflineCombat.cs;$(UpstreamHarness)/MemorySaveStore.cs;$(UpstreamHarness)/OfflineLocalization.cs;$(UpstreamHarness)/MainLoopContext.cs" />
    <Reference Include="sts2" HintPath="$(WorkDir)/bridged/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(WorkDir)/game/data_sts2_macos_arm64/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(WorkDir)/game/data_sts2_macos_arm64/0Harmony.dll" Private="false" />
    <Reference Include="CombatSolver" HintPath="$(SolverDll)" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(WorkDir)/ritsu/compat/0.111.0/STS2-RitsuLib.dll" Private="false" />
    <Reference Include="STS2-RitsuLib.Runtime" HintPath="$(WorkDir)/ritsu/compat/0.111.0/STS2-RitsuLib.Runtime.dll" Private="false" />
    <Reference Include="STS2-RitsuLib.Shared" HintPath="$(WorkDir)/ritsu/shared/STS2-RitsuLib.Shared.dll" Private="false" />
    <RuntimeHostConfigurationOption Include="ValidationInputRoot" Value="$(WorkDir)" />
    <RuntimeHostConfigurationOption Include="RuntimeGameDll" Value="$(RuntimeGameDll)" />
    <RuntimeHostConfigurationOption Include="SolverDll" Value="$(SolverDll)" />
  </ItemGroup>
  <Target Name="RequireRewrittenInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SolverDll)')" Text="Pass -p:SolverDll=... for the rewritten CombatSolver.dll." />
    <Error Condition="!Exists('$(RuntimeGameDll)')" Text="Pass -p:RuntimeGameDll=... for the paired rewritten sts2.dll." />
  </Target>
</Project>
